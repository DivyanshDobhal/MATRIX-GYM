# Server Configuration
PORT=5050
NODE_ENV=development

# Authentication Configuration
JWT_SECRET=your_jwt_secret_key_minimum_32_characters
JWT_EXPIRES_IN=7d

# CORS/Security Configuration
CLIENT_URL=http://localhost:5173

# Google Sheets Configuration
GOOGLE_SCRIPT_URL=https://script.google.com/macros/s/example/exec

# Firebase Admin Configuration
FIREBASE_PROJECT_ID=matrix-fitness-example
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-example@matrix-fitness-example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# NVIDIA NIM AI Configuration
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.3-70b-instruct

# Database Configuration
MONGO_URI=mongodb://localhost:27017/matrix-fitness
